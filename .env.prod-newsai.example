# .env.prod-newsai.example — template for the article-only "newsai" prod stack.
# Copy to .env.prod-newsai and fill in real values at deploy. The real file is gitignored.
#
#   cp .env.prod-newsai.example .env.prod-newsai && edit .env.prod-newsai
#
# DATABASE_URL / REDIS_URL point at the INTERNAL compose service names (postgres / redis),
# same pattern as dev — these resolve on the newsai-network, not the host.

# --- Django core ---
SECRET_KEY=
ALLOWED_HOSTS=newsai.<root>,.newsai.<root>,localhost,127.0.0.1,django
CORS_ALLOWED_ORIGINS=https://newsai.<root>
PRODUCT=article

# --- LLM (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
ENABLE_WEB_GROUNDING=false

# --- Postgres (isolated per-product instance; values must match DATABASE_URL below) ---
POSTGRES_DB=newsai
POSTGRES_USER=newsai_user
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://newsai_user:<pass>@postgres:5432/newsai

# --- Redis (internal broker + cache) ---
REDIS_URL=redis://redis:6379/0

# --- Host publish port for the prod nginx upstream (only django is published) ---
NEWSAI_DJANGO_PORT=8001

# --- Optional: RSSHub Twitter/X auth (leave blank if unused) ---
TWITTER_AUTH_TOKEN=
TWITTER_CT0=

# ── Article writer provider (Gemini restore) ─────────────────────────────
# ARTICLE_LLM_PROVIDER selects the article model: claude (default) | gemini.
# Gemini uses the Google AI Studio API key only (NOT GCP/Vertex) and restores
# the pre-migration article voice at ~20-60x lower cost. Flip to gemini after
# validating quality with the A/B run.
ARTICLE_LLM_PROVIDER=claude
GEMINI_API_KEY=
GEMINI_ARTICLE_MODEL=gemini-2.5-flash
